<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Canon camera helper. Runs as a long-lived child process of the booth app and
    speaks line-delimited JSON over stdin/stdout. Kept out of the Electron process
    on purpose: camera SDKs are native code, and if one crashes or hangs only this
    process dies — the booth kills it, restarts it, and falls back to the webcam.

    Same shape as photo-print-helper so it builds and ships the same way.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>canon-camera-helper</AssemblyName>
    <RootNamespace>CanonCameraHelper</RootNamespace>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!--
    Camera makers' SDKs are unpacked under sdk/ (git-ignored, licensed to the
    business). Their sample code must never be compiled in by the default **/*.cs
    glob; each backend includes exactly the wrapper files it needs.
  -->
  <ItemGroup>
    <Compile Remove="sdk/**" />
    <None Remove="sdk/**" />
  </ItemGroup>

  <!--
    Nikon Remote SDK v2 (Z series). Copied next to the helper, into nikon/, only when
    the business's SDK has been unpacked under sdk/nikon; builds without it still
    succeed and the Nikon backend reports the SDK as unavailable.
  -->
  <PropertyGroup>
    <NikonSdkBin>sdk\nikon\S-SDKZ-200BF-ALLIN\Module\Win\BinaryFile\</NikonSdkBin>
  </PropertyGroup>
  <ItemGroup Condition="Exists('$(NikonSdkBin)ControlServiceLayer.dll')">
    <NikonSdkFile Include="$(NikonSdkBin)ControlServiceLayer.dll;$(NikonSdkBin)NkdPTP.dll;$(NikonSdkBin)dnssd.dll;$(NikonSdkBin)NkRoyalmile.dll;$(NikonSdkBin)DC_PTP_Config.config;$(NikonSdkBin)MaidLayer.config;$(NikonSdkBin)RangeValue.config" />
    <None Include="@(NikonSdkFile)" Link="nikon\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

  <!--
    Sony Camera Remote SDK. Copied next to the helper, into sony/, only when both the
    business's SDK (sdk/sony/RemoteCli) and Photuna's bridge DLL (built by
    scripts/build-sony-bridge.ps1 into sdk/_build) are present.
  -->
  <PropertyGroup>
    <SonySdkBin>sdk\sony\RemoteCli\external\crsdk\</SonySdkBin>
    <SonyBridgeDll>sdk\_build\sony-bridge\Release\photuna_sony_bridge.dll</SonyBridgeDll>
  </PropertyGroup>
  <ItemGroup Condition="Exists('$(SonyBridgeDll)') And Exists('$(SonySdkBin)Cr_Core.dll')">
    <SonySdkFile Include="$(SonyBridgeDll);$(SonySdkBin)Cr_Core.dll;$(SonySdkBin)monitor_protocol.dll;$(SonySdkBin)monitor_protocol_pf.dll" />
    <SonyAdapterFile Include="$(SonySdkBin)CrAdapter\*.dll" />
    <None Include="@(SonySdkFile)" Link="sony\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Include="@(SonyAdapterFile)" Link="sony\CrAdapter\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

</Project>
