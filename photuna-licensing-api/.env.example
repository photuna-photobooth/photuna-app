PORT=8081
NODE_ENV=production
CORS_ORIGIN=https://your-website-domain.com

# Existing Supabase, Stripe, license, and auth variables go here.

# Subscription display defaults used by the website/app UI.
TRIAL_DAYS=14
DISPLAY_PRICE_CURRENCY=USD
DISPLAY_PRICE_MONTHLY_USD=$30 / mo
DISPLAY_PRICE_YEARLY_USD=$204 / yr
DISPLAY_PRICE_MONTHLY_AMOUNT=30
DISPLAY_PRICE_YEARLY_AMOUNT=204

# Google Places API reviews
# Use the Google Maps Platform Places API (New). Keep this key server-side.
GOOGLE_PLACES_API_KEY=your_google_places_api_key

# Accepts either "ChIJ..." or "places/ChIJ...".
GOOGLE_PLACE_ID=your_google_place_id

# Optional. Defaults to 1 hour.
GOOGLE_REVIEWS_CACHE_TTL_MS=3600000
